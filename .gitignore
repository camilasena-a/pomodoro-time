node_modules/
*.js.map
*.d.ts
*.d.ts.map
.DS_Store
dist/

# Ignorar arquivos JavaScript compilados do TypeScript (exceto script.js na raiz)
src/**/*.js
src/**/*.js.map
src/**/*.d.ts
src/**/*.d.ts.map

# Manter script.js no repositório (necessário para GitHub Pages)
# Não ignorar script.js na raiz
!script.js

# IDEs e editores
# Manter .vscode/settings.json e .vscode/extensions.json
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Sistema operacional
Thumbs.db
.DS_Store
desktop.ini

# Temporários
*.tmp
*.temp
.cache/
